# ==============================================================================
# Git Ignore - Production EKS Platform
# Proactive protection against accidental commits of secrets, state, and caches
# ==============================================================================

# Environment files and local secrets
.env
.env.*
!.env.example
*.env

# Cloud & Infrastructure Credentials
credentials
credentials.json
*.pem
*.key
*.pkcs12
*.pfx
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Kubernetes local files & configs
*kubeconfig*
*.kubeconfig
kubeconfig
kubeconfig.yaml
kubeconfig.yml

# Terraform local state and logs
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/

# Node.js artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor metadata
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.#*

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files and scratch directories
tmp/
temp/
*.tmp
scratch/
local/
